<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="PixelStore.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PixelStore"
    Shell.FlyoutBehavior="Disabled"
    Title="Pixel Store">

    <TabBar>
        <ShellContent
            Title="Shop"
            ContentTemplate="{DataTemplate local:ShopPage}"
            Route="ShopPage" />

        <ShellContent
            Title="Checkout"
            ContentTemplate="{DataTemplate local:CheckoutPage}"
            Route="CheckoutPage" />
    </TabBar>

</Shell>
